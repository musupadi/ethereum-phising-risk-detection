# .gitignore for ethereum-phishing-risk-detection
# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── ML artifacts ──────────────────────────────────────────────────────────────
ml/artifacts/model.pkl
ml/artifacts/scaler.pkl
# Keep plots and schema in git (they're small)

# ── Data ──────────────────────────────────────────────────────────────────────
# The raw EPTransNet graph is large + third-party: never re-upload it. Everything
# else under data/ (Etherscan/BigQuery enrichment CSVs, the derived hybrid dataset,
# train/test splits) is committed so the 8,595-wallet population is reproducible
# without redistributing the raw graph.
data/raw/MulDiGraph.pkl
data/raw/*.pkl
Ethereum Phishing Transaction Network/

# ── Node / Hardhat ────────────────────────────────────────────────────────────
chain/node_modules/
chain/artifacts/
chain/cache/
chain/dist/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
*.swp
.env
primal-library-239611-b6941382db9f.json

# ── Thesis documents (jangan commit ke repo) ─────────────────────────────────
*.docx
