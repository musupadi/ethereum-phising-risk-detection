flowchart TD
    A[Deployer] -->|deploy contract| B[RiskRegistry]
    B --> C[(owner)]
    B --> D[(mapping _records)]

    E[Authorized Owner] -->|call setRisk(wallet, score, modelVersion)| F{onlyOwner?}
    F -- No --> G[revert: caller is not the owner]
    F -- Yes --> H{score <= 100?}
    H -- No --> I[revert: score must be <= 100]
    H -- Yes --> J[ts = block.timestamp]
    J --> K[update _records[wallet] = Record(score, ts, modelVersion)]
    K --> L[emit RiskUpdated(wallet, score, ts, modelVersion)]

    M[Client / API] -->|call getRisk(wallet)| N[read _records[wallet]]
    N --> O[return riskScore, timestamp, modelVersion]

    P[Owner] -->|call transferOwnership(newOwner)| Q{newOwner != 0x0?}
    Q -- No --> R[revert: zero address]
    Q -- Yes --> S[owner = newOwner]
