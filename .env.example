# Environment Configuration for ML Pipeline
# Copy this file to .env and fill in your API keys

# ── Etherscan API ──────────────────────────────────────────────────────────────
# Get your free API key: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Forta Network API ──────────────────────────────────────────────────────────
# Get your API key: https://app.forta.network/api-keys
FORTA_API_KEY=your_forta_api_key_here

# ── Machine Learning Configuration ────────────────────────────────────────────
# Model training settings

# Primary metric for model selection
ML_PRIMARY_METRIC=f1  # Options: f1, accuracy, roc_auc, precision, recall

# Training datasets to use
ML_USE_BASELINE_DATASET=true
ML_USE_ETHERSCAN_DATASET=false   # Set to true after enrichment
ML_USE_FORTA_DATASET=false       # Set to true after enrichment

# Random seed for reproducibility
ML_RANDOM_SEED=42

# ── Model Selection ────────────────────────────────────────────────────────────
# Which models to train (set to false to skip)

ML_TRAIN_LOGISTIC_REGRESSION=true
ML_TRAIN_RANDOM_FOREST=true
ML_TRAIN_XGBOOST=true
ML_TRAIN_GNN_GCN=true
ML_TRAIN_GNN_GAT=true

# ── XGBoost Hyperparameters ───────────────────────────────────────────────────

XGB_N_ESTIMATORS=300
XGB_MAX_DEPTH=8
XGB_LEARNING_RATE=0.05
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8
XGB_EARLY_STOPPING_ROUNDS=50

# ── GNN Hyperparameters ───────────────────────────────────────────────────────

GNN_HIDDEN_DIM=64
GNN_DROPOUT=0.5
GNN_EPOCHS=100
GNN_EARLY_STOPPING_PATIENCE=20
GNN_NUM_NEIGHBORS=10  # For graph construction

# ── Data Fetching ─────────────────────────────────────────────────────────────

# Etherscan settings
ETHERSCAN_REQUEST_DELAY=0.2  # Seconds between requests (5 req/sec max)
ETHERSCAN_BATCH_SIZE=100     # Addresses per batch
ETHERSCAN_TIMEOUT=10         # Request timeout in seconds
ETHERSCAN_PER_RUN_LIMIT=0    # 0 = all pending addresses

# BigQuery settings
# Fill these values in .env (project-local file, do not commit secrets)
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_TABLE=bigquery-public-data.crypto_ethereum.transactions
BIGQUERY_DAYS_WINDOW=90
BIGQUERY_PER_RUN_LIMIT=1000  # 0 = all pending addresses
BIGQUERY_CHUNK_SIZE=300
# Use absolute path to your service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your-service-account.json

# Forta settings
FORTA_REQUEST_DELAY=0.2
FORTA_BATCH_SIZE=50
FORTA_TIMEOUT=10

# Sample limit for testing (set to 0 for all)
DATA_SAMPLE_LIMIT=0

# ── Logging ────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Paths ──────────────────────────────────────────────────────────────────────
# Usually auto-detected, customize if needed

# MODEL_ARTIFACTS_DIR=./ml/artifacts
# DATA_PROCESSED_DIR=./data/processed
# DATA_RAW_DIR=./data/raw
